<odoo>
    <record id="rma_view_form" model="ir.ui.view">
        <field name="name">rma.view.form</field>
        <field name="model">rma</field>
        <field name="inherit_id" ref="rma.rma_view_form" />
        <field name="arch" type="xml">
            <field name="location_id" position="after">
                <field
                    name="route_area_id"
                    required="carrier_delivery_type=='route_planning'"
                    invisible="carrier_delivery_type != 'route_planning'"
                    readonly="state not in ('draft', 'confirmed', 'received')"
                    options="{'no_create': True, 'no_open': True}"
                    groups="route_planning.group_route_planning_user"
                />
                <field
                    name="reception_route_area_id"
                    required="reception_carrier_delivery_type=='route_planning'"
                    invisible="reception_carrier_delivery_type != 'route_planning'"
                    readonly="state not in ('draft', 'confirmed') or reception_move_id"
                    options="{'no_create': True, 'no_open': True}"
                    groups="route_planning.group_route_planning_user"
                />
            </field>
        </field>
    </record>
</odoo>
