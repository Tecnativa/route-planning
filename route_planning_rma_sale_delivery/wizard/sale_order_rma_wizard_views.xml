<odoo>
    <record id="sale_order_rma_wizard_form_view" model="ir.ui.view">
        <field name="model">sale.order.rma.wizard</field>
        <field
            name="inherit_id"
            ref="rma_sale_delivery.sale_order_rma_wizard_form_view"
        />
        <field name="arch" type="xml">
            <field name="reception_carrier_id" position="after">
                <field
                    name="reception_route_area_id"
                    required="reception_carrier_delivery_type=='route_planning'"
                    invisible="reception_carrier_delivery_type != 'route_planning'"
                    options="{'no_create': True, 'no_open': True}"
                    groups="route_planning.group_route_planning_user"
                />
            </field>
        </field>
    </record>
</odoo>
