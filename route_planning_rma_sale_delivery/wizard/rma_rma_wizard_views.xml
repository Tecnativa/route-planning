<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="rma_rma_wizard_form_view" model="ir.ui.view">
        <field name="model">rma.rma.wizard</field>
        <field
            name="inherit_id"
            ref="route_planning_rma_sale.rma_rma_wizard_form_view"
        />
        <field name="arch" type="xml">
            <field name="reception_route_area_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>
    <record id="delivery_rma_rma_wizard_form_view" model="ir.ui.view">
        <field name="model">rma.rma.wizard</field>
        <field name="inherit_id" ref="rma_delivery.rma_rma_wizard_form_view" />
        <field name="arch" type="xml">
            <field name="reception_carrier_id" position="after">
                <field
                    name="reception_route_area_id"
                    required="delivery_type=='route_planning'"
                    invisible="delivery_type != 'route_planning'"
                    options="{'no_create': True, 'no_open': True}"
                    groups="route_planning.group_route_planning_user"
                />
            </field>
        </field>
    </record>
</odoo>
